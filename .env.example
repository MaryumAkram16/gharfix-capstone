# Optional. Endpoints not yet ported are forwarded here; unset = they answer 503.
N8N_WEBHOOK_BASE_URL=

# Supabase (server-side only; never expose the service-role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, milliseconds (default 8000)
SUPABASE_TIMEOUT_MS=

# Email (Gmail SMTP). Both unset = emails are only logged (console fallback).
# GMAIL_APP_PASSWORD is a Google app password (needs 2-Step Verification), not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: sender display name (default GharFix) and per-phase SMTP timeout in ms (default 8000)
EMAIL_FROM_NAME=
EMAIL_TIMEOUT_MS=

# Intent parsing (khadmat-intent). Unset GEMINI_API_KEY = keyword parser only (src/lib/intent.ts).
GEMINI_API_KEY=
# Optional: model (default gemini-3.8-flash) and request timeout in ms (default 8000)
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=

# Provider search (khadmat-provider-match), OpenStreetMap. All optional; defaults are the public
# nominatim.openstreetmap.org and overpass-api.de, which have usage limits (see lib/matching/osm.ts).
NOMINATIM_URL=
OVERPASS_URL=
# Second Overpass instance, tried when the first fails (default overpass.kumi.systems; "off" disables)
OVERPASS_FALLBACK_URL=
# Timeouts in ms (1000-60000): Nominatim per request (default 5000), Overpass per instance (default 8000),
# and the total across both Overpass instances (default 12000)
NOMINATIM_TIMEOUT_MS=
OVERPASS_TIMEOUT_MS=
OVERPASS_BUDGET_MS=
# Identifying User-Agent the OSM policies require; set it to include a contact URL for your deployment.
OSM_USER_AGENT=

# Demo providers (fictional, db/seed/demo_providers.json, Lahore + Islamabad only). Exactly "1" enables
# them, used only when OpenStreetMap returns zero providers or fails (both Overpass instances); responses
# then have data_source "demo_seed" and the app shows a "Demo data" label. Leave unset in production.
USE_DEMO_PROVIDERS=

# Alerts (lib/resilience). One plain-language email per distinct failure, sent through the Gmail settings
# above (or only logged by the console fallback). Unset ALERT_EMAIL = incidents are recorded but not emailed.
ALERT_EMAIL=
# Optional: minutes before the same failure alerts again (default 60)
ALERT_DEDUPE_MINUTES=

# api/reconcile.ts bearer token. Use a long random value, and store the same value as the CRON_SECRET
# GitHub repository secret (with RECONCILE_URL) for .github/workflows/reconcile.yml. Unset = endpoint refuses to run.
CRON_SECRET=
